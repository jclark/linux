#include "socfpga_agilex5.dtsi"

/ {
	model = "Terasic DE25-Nano";
	compatible = "terasic,de25-nano", "intel,socfpga-agilex5";

	aliases {
		serial0 = &uart1;
		ethernet0 = &gmac0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	leds {
		compatible = "gpio-leds";

		led-0 {
			label = "hps_led0";
			gpios = <&portb 17 GPIO_ACTIVE_HIGH>;
		};
	};

	memory@80000000 {
		device_type = "memory";
		/* We expect the bootloader to fill in the reg */
		reg = <0x0 0x80000000 0x0 0x0>;
	};

	sd_power: regulator-sd-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "card-power";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	sd_io: regulator-sd-io {
		compatible = "regulator-gpio";
		regulator-name = "sd-bus-io-power";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <3300000>;
		gpios = <&portb 3 GPIO_ACTIVE_HIGH>;
		states = <1800000 0x1>,
			 <3300000 0x0>;
	};
};

&gmac0 {
	status = "okay";
	/* TX/RX delays are on the PCB */
	phy-mode = "rgmii";
	phy-handle = <&emac0_phy0>;
	max-frame-size = <9000>;

	mdio0 {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "snps,dwmac-mdio";

		emac0_phy0: ethernet-phy@1 {
			reg = <1>;
		};
	};
};

&gpio1 {
	status = "okay";
};

&i2c1 {
	status = "okay";
};

&mmc {
	status = "okay";
	no-1-8-v;
	disable-wp;
	cap-sd-highspeed;
	bus-width = <4>;
	vmmc-supply = <&sd_power>;
	vqmmc-supply = <&sd_io>;
	max-frequency = <200000000>;
	sdhci-caps = <0x00000000 0x0000c800>;
	sdhci-caps-mask = <0x00002007 0x0000ff00>;
};

&osc1 {
	clock-frequency = <25000000>;
};

&qspi {
	/*
	 * The QSPI flash belongs to the SDM while the board boots from it (AS
	 * mode). With Terasic's U-Boot the HPS has no access: U-Boot "sf probe"
	 * fails and the cadence-qspi probe takes an SError. Terasic's own dts
	 * leaves the controller disabled.
	 */
	status = "disabled";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <100000000>;
		m25p,fast-read;
		cdns,read-delay = <2>;
		cdns,tshsl-ns = <50>;
		cdns,tsd2d-ns = <50>;
		cdns,tchsh-ns = <4>;
		cdns,tslch-ns = <4>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x0 0x01000000>;
			};
		};
	};
};

&smmu {
	status = "okay";
};

&uart1 {
	status = "okay";
};

&usb0 {
	status = "okay";
	disable-over-current;
};

&watchdog0 {
	status = "okay";
};
