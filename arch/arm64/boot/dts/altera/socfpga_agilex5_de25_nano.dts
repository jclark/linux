#include "socfpga_agilex5.dtsi"

/ {
	model = "Terasic DE25-Nano";
	compatible = "terasic,de25-nano", "intel,socfpga-agilex5";

	aliases {
		serial0 = &uart1;
		ethernet0 = &gmac0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	leds {
		compatible = "gpio-leds";

		led-0 {
			label = "hps_led0";
			gpios = <&portb 17 GPIO_ACTIVE_HIGH>;
		};
	};

	memory@80000000 {
		device_type = "memory";
		/* We expect the bootloader to fill in the reg */
		reg = <0x0 0x80000000 0x0 0x0>;
	};
};

&gmac0 {
	/* TX/RX delays are on the PCB */
	phy-mode = "rgmii";
	phy-handle = <&emac0_phy0>;
	max-frame-size = <9000>;

	status = "okay";

	mdio0 {
		compatible = "snps,dwmac-mdio";
		#address-cells = <1>;
		#size-cells = <0>;

		emac0_phy0: ethernet-phy@1 {
			reg = <1>;
		};
	};
};

&gpio1 {
	status = "okay";
};

&i2c1 {
	status = "okay";
};

&osc1 {
	clock-frequency = <25000000>;
};

&qspi {
	/*
	 * The QSPI flash belongs to the SDM while the board boots from it (AS
	 * mode). With Terasic's U-Boot the HPS has no access: U-Boot "sf probe"
	 * fails and the cadence-qspi probe takes an SError. Terasic's own dts
	 * leaves the controller disabled. U-Boot (ft_board_setup) sets it okay
	 * when the SDM has handed the flash to the HPS.
	 */
	status = "disabled";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <100000000>;
		m25p,fast-read;
		cdns,read-delay = <2>;
		cdns,tshsl-ns = <50>;
		cdns,tsd2d-ns = <50>;
		cdns,tchsh-ns = <4>;
		cdns,tslch-ns = <4>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x0 0x01000000>;
			};
		};
	};
};

&sdmmc {
	bus-width = <4>;
	cap-sd-highspeed;
	disable-wp;
	no-1-8-v;
	no-mmc;
	no-sdio;

	status = "okay";
};

&smmu {
	status = "okay";
};

&uart1 {
	status = "okay";
};

&usb0 {
	disable-over-current;

	status = "okay";
};

&watchdog0 {
	status = "okay";
};
